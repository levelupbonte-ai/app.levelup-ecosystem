rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: each user accesses their own document only.
    // Prevents privilege escalation (cannot modify 'role' or 'isAdmin' fields).
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
                    && request.resource.data.user_id == userId;
      allow update: if isOwner(userId)
                    && request.resource.data.user_id == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'permissions']));
      allow delete: if false;
    }

    // Projects and showcase: public read, authenticated writes
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Dynamic media and image assets catalog: public read, authenticated uploads
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Real-time client error sensor logs: write-only from public visitors with string checks
    match /error_logs/{errorId} {
      allow create: if request.resource.data.message is string;
      allow read, update, delete: if isAuthenticated();
    }

    // Contact form submissions: validation of input fields, write-only from public
    match /contacts/{contactId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 150
                    && request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAuthenticated();
    }

    // Preview requests and build queue: validation of required fields
    match /preview_requests/{requestId} {
      allow create: if request.resource.data.businessName is string
                    && request.resource.data.businessName.size() > 0
                    && request.resource.data.email is string;
      allow read: if true;
      allow update, delete: if isAuthenticated();
    }

    // Email dispatch audit logs: write-only from server/client, authenticated manage
    match /email_logs/{logId} {
      allow create: if request.resource.data.to is string;
      allow read, update, delete: if isAuthenticated();
    }

    // Event bookings and invitations (e.g. Wedding RSVPs)
    match /bookings/{bookingId} {
      allow create: if request.resource.data.name is string;
      allow read, update, delete: if isAuthenticated();
    }

    // Wedding RSVP parties and artifact data
    match /parties/{partyId} {
      allow create: if request.resource.data.partyName is string;
      allow read, update: if isAuthenticated();
    }

    match /artifacts/{appId}/public/data/parties/{partyId} {
      allow create, read: if true;
      allow update, delete: if isAuthenticated();
    }

    // Newsletter signups: strict email string check
    match /newsletter/{newsletterId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() <= 200;
      allow read, delete: if isAuthenticated();
    }

    // STRICT DEFAULT: Deny all unspecified paths (Zero-Trust)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
